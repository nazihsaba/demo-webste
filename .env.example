# Copy this file to .env.local and fill in the values.
# On Vercel, add the same three under Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The live address of this site, used for link previews on WhatsApp.
# Leave empty on Vercel to use the project's own address.
NEXT_PUBLIC_SITE_URL=

# Set to 1 to run on the built-in sample businesses, no database needed.
# USE_SAMPLE_DATA=1
